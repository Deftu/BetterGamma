{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "Deftu"
    ],
    "icon": "assets/bettergamma/logo.png",
    "contact": {
        "homepage": "https://deftu.dev/",
        "issues": "https://github.com/Deftu/BetterGamma/issues",
        "sources": "https://github.com/Deftu/BetterGamma"
    },
    "license": "AGPL-3.0-or-later",
    "environment": "client",
    "entrypoints": {
        "client": [
            {
                "adapter": "kotlin",
                "value": "dev.deftu.bettergamma.BetterGamma"
            }
        ]
    },
    "mixins": [
        "bettergamma.mixins.json"
    ],
    "depends": {
        "minecraft": "${minecraft_version_range}",
        "fabricloader": ">=${loader_version}",
        "java": ">=${java_version}",
        "fabric-language-kotlin": "*",
        "oneconfigv1": ">=${oneconfig_version}"
    }
}
